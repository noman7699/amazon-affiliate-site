    </article>

    <article class="card" data-category="Home">
      <img src="https://placehold.co/400x300?text=Desk+Lamp"
           alt="Desk lamp">
      <div class="card-content">
        <h3>Desk Lamp</h3>
        <p>Browse desk lamps for study spaces and home offices.</p>
        <a class="buy" href="https://www.amazon.com/s?k=desk+lamp"
           target="_blank" rel="nofollow sponsored noopener">View on Amazon</a>
      </div>
    </article>

  </div>

  <p id="empty" class="empty">No matching products found.</p>

  <div class="notice">
    <strong>Affiliate Disclosure:</strong>
    As an Amazon Associate, I may earn from qualifying purchases.
    Prices and availability are determined by Amazon.
  </div>
</section>

<section class="section" id="about">
  <h2>About Us</h2>
  <p>
    Smart Deals helps visitors discover useful products and explore
    shopping options. Please check product details on Amazon before buying.
  </p>
</section>

<section class="section" id="contact">
  <h2>Contact Us</h2>
  <p>For questions, contact the website owner using your published contact email.</p>
</section>

<section class="section" id="privacy">
  <h2>Privacy Policy</h2>
  <p>
    This demo website does not collect information through a contact form.
    External websites may use their own cookies and privacy practices.
    Review Amazon's privacy policy before shopping.
  </p>
</section>
</main>

<footer>
  <p>© <span id="year"></span> Smart Deals Store</p>
  <p>
    <a href="#about">About</a>
    <a href="#privacy">Privacy Policy</a>
    <a href="#contact">Contact</a>
  </p>
</footer>

<script>
const search = document.getElementById("search");
const cards = [...document.querySelectorAll(".card")];
const buttons = [...document.querySelectorAll(".category")];
const empty = document.getElementById("empty");

let selectedCategory = "All";

function filterProducts() {
  const query = search.value.toLowerCase().trim();
  let visible = 0;

  cards.forEach(card => {
    const matchesText = card.innerText.toLowerCase().includes(query);
    const matchesCategory =
      selectedCategory === "All" ||
      card.dataset.category === selectedCategory;

    const show = matchesText && matchesCategory;
    card.style.display = show ? "" : "none";

    if (show) visible++;
  });

  empty.style.display = visible ? "none" : "block";
}

search.addEventListener("input", filterProducts);

buttons.forEach(button => {
  button.addEventListener("click", () => {
    selectedCategory = button.dataset.category;

    buttons.forEach(item => item.classList.remove("active"));
    button.classList.add("active");

    filterProducts();
  });
});

document.getElementById("year").textContent =
  new Date().getFullYear();
</script>

</body>
</html>
